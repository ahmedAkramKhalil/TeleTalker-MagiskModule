#!/system/bin/sh
# Stream audio injection script

MODE="${1:-stream}"  # stream or file
AUDIO_FILE="$2"
CONFIG_FILE="/data/local/tmp/call_injector/mixer_config.txt"
PIPE_FILE="/data/local/tmp/call_injector/audio_stream.pipe"

# Load configuration
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    /system/bin/sh /data/adb/modules/com.teletalker.app/detect_mixers.sh
    source "$CONFIG_FILE"
fi

# Function for streaming mode
stream_mode() {
    # Create named pipe
    rm -f "$PIPE_FILE" 2>/dev/null
    mkfifo "$PIPE_FILE"
    chmod 666 "$PIPE_FILE"
    
    # Enable mixer
    tinymix "$MIXER_CONTROL" 1
    
    echo "Streaming pipe ready at: $PIPE_FILE"
    echo "Write PCM data to this pipe to inject into call"
    
    # Keep playing from pipe
    while [ -p "$PIPE_FILE" ]; do
        tinyplay "$PIPE_FILE" -D 0 -d "$DEVICE_ID" 2>/dev/null
    done
    
    # Disable mixer
    tinymix "$MIXER_CONTROL" 0
}

# Function for file mode
file_mode() {
    tinymix "$MIXER_CONTROL" 1
    tinyplay "$AUDIO_FILE" -D 0 -d "$DEVICE_ID"
    tinymix "$MIXER_CONTROL" 0
}

case "$MODE" in
    stream)
        stream_mode
        ;;
    file)
        file_mode
        ;;
esac